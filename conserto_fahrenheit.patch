+    # colapsa quando os numeros sao IGUAIS: valores diferentes podem ser dois
+    # passos da receita ("doure a 220°C e termine a 180°C").
+    t = re.sub(r"(\d+)\s*°\s*C\s*(?:or|ou|/|,)?\s*\1\s*°\s*C\b",
